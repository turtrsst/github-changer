# Salin ke .env (opsional). Semua parameter juga bisa diatur lewat halaman Parameters di UI.
# Nilai dari environment selalu menang atas config file dan ditandai "env" di UI.

# --- Server ---
HOST=0.0.0.0
PORT=4173

# --- GitHub OAuth (WAJIB untuk login GitHub asli) ---
# Buat OAuth App di https://github.com/settings/developers
# lalu centang "Enable Device Flow". Client ID saja, TANPA client secret.
GITHUB_CLIENT_ID=

# --- Keamanan (opsional) ---
# Kunci enkripsi token di disk. Kalau kosong, dibuat otomatis di data/secret.key (mode 0600).
APP_SECRET=
# PIN tambahan untuk membuka app (opsional, dikirim lewat header X-App-Pin).
APP_PIN=

# --- Git di komputer/server (opsional, auto-detect kalau kosong) ---
# Windows: kalau Git tidak ada di PATH, isi path absolut, mis:
# GHC_GIT_BINARY=C:\Program Files\Git\cmd\git.exe
GHC_GIT_BINARY=git
# Host untuk autentikasi push/pull (default github.com; ganti untuk GHE)
GHC_GIT_HOST=github.com
# Beberapa root dipisah ";" di Windows, ":" di Linux/macOS
# GHC_WORKSPACE_ROOTS=C:\xampp\htdocs;C:\Users\Administrator\Documents\GitHub
GHC_WORKSPACE_ROOTS=
GHC_DATA_DIR=
